{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proplet",
  "main": "src/main.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "proplet.net/*",
      "zone_name": "proplet.net",
    },
    {
      "pattern": "proplet.net",
      "zone_name": "proplet.net",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
  ],
  "preview_urls": false,
  "vars": {
    "STORAGE_TYPE": "disk",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "workers_dev": true,
}
